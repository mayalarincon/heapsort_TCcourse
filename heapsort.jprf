 "heapsort.sink_length": [
  {
   "info": {
    "theory": "heapsort",
    "formula": "sink_length",
    "status": "proved",
    "prover": "PVS 8.1 (SBCL 2.4.8)",
    "shasum": "916f11e157ba40e4a5a7daee413c2d96f264c69796cdff1e24b9591e0ab41a92"
   },
   "origin": ".prf",
   "proofTree": {
    "branch": "",
    "name": "sink_length",
    "type": "root",
    "rules": [
     {
      "branch": "",
      "name": "(MEASURE-INDUCT+ \"n - i\" (\"h\" \"i\" \"n\"))",
      "type": "proof-command",
      "rules": [
       {
        "branch": "1",
        "name": "(1)",
        "type": "proof-branch",
        "rules": [
         {
          "branch": "1",
          "name": "(NAME-REPLACE \"h\" \"x!1\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(NAME-REPLACE \"i\" \"x!2\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(NAME-REPLACE \"n\" \"x!3\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(COMMENT \"Induction on n - i. IH: length(sink(h1)(i1,n1)) = length(h1) whenever n1 - i1 < n - i\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(EXPAND \"sink\" 1)",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(LIFT-IF)",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(PROP)",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(COMMENT \"When sink returns h the goal is trivial. Remaining case: sink(swap(h)(i,c))(c,n), with c = ind_gc(h)(n,i)\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "1",
          "name": "(INST -2 \"swap(h)(i, ind_gc(h)(n, i))\" \"ind_gc(h)(n, i)\" \"n\")",
          "type": "proof-command",
          "rules": [
           {
            "branch": "1.1",
            "name": "(1.1)",
            "type": "proof-branch",
            "rules": [
             {
              "branch": "1.1",
              "name": "(SPLIT -2)",
              "type": "proof-command",
              "rules": [
               {
                "branch": "1.1.1",
                "name": "(1.1.1)",
                "type": "proof-branch",
                "rules": [
                 {
                  "branch": "1.1.1",
                  "name": "(COMMENT \"IH: length(sink(swap(h)(i,c))(c,n)) = length(swap(h)(i,c)), and swap keeps the length\")",
                  "type": "proof-command",
                  "rules": []
                 },
                 {
                  "branch": "1.1.1",
                  "name": "(REPLACE -1 1)",
                  "type": "proof-command",
                  "rules": []
                 },
                 {
                  "branch": "1.1.1",
                  "name": "(EXPAND \"swap\" 1)",
                  "type": "proof-command",
                  "rules": []
                 }
                ]
               },
               {
                "branch": "1.1.2",
                "name": "(1.1.2)",
                "type": "proof-branch",
                "rules": [
                 {
                  "branch": "1.1.2",
                  "name": "(COMMENT \"The measure decreases: n - c < n - i, since the child c is 2i+1 or 2i+2\")",
                  "type": "proof-command",
                  "rules": []
                 },
                 {
                  "branch": "1.1.2",
                  "name": "(HIDE -1 2)",
                  "type": "proof-command",
                  "rules": []
                 },
                 {
                  "branch": "1.1.2",
                  "name": "(GRIND)",
                  "type": "proof-command",
                  "rules": []
                 }
                ]
               }
              ]
             }
            ]
           },
           {
            "branch": "1.2",
            "name": "(1.2)",
            "type": "proof-branch",
            "rules": [
             {
              "branch": "1.2",
              "name": "(COMMENT \"TCC: (c, n) are valid indices for swap(h)(i,c); uses the type of n: i <= n < length(h)\")",
              "type": "proof-command",
              "rules": []
             },
             {
              "branch": "1.2",
              "name": "(HIDE -1 2)",
              "type": "proof-command",
              "rules": []
             },
             {
              "branch": "1.2",
              "name": "(TYPEPRED \"n\")",
              "type": "proof-command",
              "rules": []
             },
             {
              "branch": "1.2",
              "name": "(EXPAND \"n\")",
              "type": "proof-command",
              "rules": []
             },
             {
              "branch": "1.2",
              "name": "(EXPAND \"h\")",
              "type": "proof-command",
              "rules": []
             },
             {
              "branch": "1.2",
              "name": "(GRIND)",
              "type": "proof-command",
              "rules": []
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "branch": "2",
        "name": "(2)",
        "type": "proof-branch",
        "rules": [
         {
          "branch": "2",
          "name": "(COMMENT \"TCC of the induction: i < length(h)\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "2",
          "name": "(TYPEPRED \"x!1`2\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "2",
          "name": "(GRIND)",
          "type": "proof-command",
          "rules": []
         }
        ]
       },
       {
        "branch": "3",
        "name": "(3)",
        "type": "proof-branch",
        "rules": [
         {
          "branch": "3",
          "name": "(COMMENT \"TCC of the induction: well-typed measure\")",
          "type": "proof-command",
          "rules": []
         },
         {
          "branch": "3",
          "name": "(GRIND)",
          "type": "proof-command",
          "rules": []
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ],
